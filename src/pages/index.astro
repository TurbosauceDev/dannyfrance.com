---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Pledge from '../components/Pledge.astro';
import { getPosts } from '../lib';
import home from '../data/home.json';
const intro = home.intro.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const recent = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="card hero">
    <h1 class="pt">Hi, I'm Danny.</h1>
    {intro.length === 0
      ? <p class="todo">Placeholder: Danny writes the intro (/keystatic → Home page).</p>
      : intro.map((para) => <p>{para}</p>)}
    {home.tagline && <p style="margin:0">{home.tagline}</p>}
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
      <a class="btn primary" href="/blog">Read the blog</a>
      <a class="btn" href="/projects">Projects</a>
      <a class="btn" href="/resume">Resume</a>
    </div>
  </section>

  <h2>Latest posts</h2>
  <PostList posts={recent} />

  <h2>Written by a human</h2>
  <Pledge />
</Base>

---
import Base from '../layouts/Base.astro';
import Pledge from '../components/Pledge.astro';
---
<Base title="Written by a human" description="Every post on dannyfrance.com is written by Danny. No LLM-generated posts, ever.">
  <h1 class="pt">Written by a human</h1>
  <p class="lede">Every post on this site is written by me. No LLM-generated posts, ever. This is the promise, timestamped, from the day the site started.</p>
  <Pledge />
  <h2>What that covers</h2>
  <div class="card prose">
    <p>The words in every blog post are mine. Tools may help me build the site itself, the code, the theme, the deploy, but they don't write the posts.</p>
  </div>
</Base>

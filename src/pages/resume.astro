---
import Base from '../layouts/Base.astro';
// Edited in the site editor (/keystatic → Resume), stored in src/data/resume.json.
import resume from '../data/resume.json';
type Item = { what: string; where?: string; when?: string; note?: string };
const sections = resume.sections as { title: string; items: Item[] }[];
const empty = sections.every((s) => s.items.length === 0);
---
<Base title="Resume" description="Danny France's resume.">
  <h1 class="pt">Resume</h1>
  {resume.lede && <p class="lede">{resume.lede}</p>}
  {empty && <p class="todo">Placeholder: Danny fills in the resume (/keystatic → Resume).</p>}
  {sections.map((s) => (
    <section class="rsec">
      <h2>{s.title}</h2>
      <div class="card">
        {s.items.length === 0 ? <p class="muted" style="margin:0">Coming soon.</p> :
          s.items.map((i: any) => (
            <div class="rrow"><div><b>{i.what}</b>{i.where && <span class="muted"> · {i.where}</span>}{i.note && <div class="sub">{i.note}</div>}</div><span class="meta">{i.when}</span></div>
          ))}
      </div>
    </section>
  ))}
</Base>
